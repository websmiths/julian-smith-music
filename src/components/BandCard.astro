---
import { site, type GenreKey } from '../lib/site';

interface Props {
  band: {
    id: string;
    data: {
      name: string;
      role: 'core' | 'sub' | 'session' | 'video';
      julianRole: string;
      genres: string[];
      accent?: string;
      era: string;
      region?: string;
      blurb: string;
      confirmed: boolean;
      image?: string;
      imagePosition?: string;
    };
  };
  feature?: boolean;
  variant?: 'paper' | 'dark';
}

const { band, feature = false, variant = 'paper' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dark = variant === 'dark';
const padClass = feature ? 'p-6' : 'p-5';
const imageNegMargin = feature ? '-mx-6 -mt-6 mb-5' : '-mx-5 -mt-5 mb-4';
---
<a
  href={`${base}/bands/${band.id}`}
  class:list={[
    'group block border transition-colors overflow-hidden',
    dark
      ? 'border-[var(--color-dark-soft)] bg-[var(--color-dark-soft)] hover:border-[var(--color-dark-text)]'
      : 'border-[var(--color-rule-soft)] bg-[var(--color-paper)] hover:border-[var(--color-ink)]',
    padClass,
  ]}
>
  {band.data.image && (
    <div class:list={['aspect-[4/3] bg-[var(--color-paper-deep)] overflow-hidden', imageNegMargin]}>
      <img
        src={`${base}${band.data.image}`}
        alt={band.data.name}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
        style={band.data.imagePosition ? `object-position: ${band.data.imagePosition}` : undefined}
      />
    </div>
  )}
  <div class="flex items-baseline justify-between gap-4 mb-2">
    <span class="eyebrow">{site.roleLabels[band.data.role]}</span>
    {!band.data.confirmed && <span class="eyebrow opacity-70">draft</span>}
  </div>
  <h3 class:list={[
    'font-[var(--font-display)] font-bold leading-tight',
    feature ? 'text-2xl md:text-3xl' : 'text-xl',
    dark ? 'text-[var(--color-dark-text)]' : 'text-[var(--color-ink)]',
  ]}>
    {band.data.name}
  </h3>
  <p class:list={[
    'mt-1 text-xs font-[var(--font-sans)]',
    dark ? 'text-[var(--color-dark-muted)]' : 'text-[var(--color-muted)]',
  ]}>
    {band.data.era}{band.data.region ? ` · ${band.data.region}` : ''}
  </p>
  <p class:list={[
    'mt-3 text-sm leading-relaxed',
    dark ? 'text-[var(--color-dark-text)]' : 'text-[var(--color-ink-soft)]',
  ]}>
    {band.data.blurb}
  </p>
  <div class="mt-4 flex flex-wrap gap-1">
    {band.data.genres.map((g) => (
      <span class="chip">{site.genreLabels[g as GenreKey] ?? g}</span>
    ))}
  </div>
  <p class:list={[
    'mt-4 text-xs font-[var(--font-sans)]',
    dark ? 'text-[var(--color-dark-muted)]' : 'text-[var(--color-muted)]',
  ]}>
    {band.data.julianRole}
  </p>
</a>
