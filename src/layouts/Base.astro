---
import '../styles/global.css';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const desc = description ?? `${site.name}: ${site.tagline}.`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(base, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">

    <!-- Ambient background blobs: fixed to viewport, z-index:-1 inside
         body's isolated stacking context. CSS border-radius with 8 values
         creates organic amorphous shapes; mix-blend-mode:multiply makes
         overlapping areas visibly darken. -->
    <div aria-hidden="true" style="position:fixed;inset:0;z-index:-1;pointer-events:none;">
      <!-- Positions and border-radii are randomised by the inline script below -->
      <!-- Upper-left zone: sage green -->
      <div data-blob class="ambient-shape-1" style="position:absolute;width:65vw;height:58vh;top:-8vh;left:-14vw;background:rgba(100,148,112,0.12);border-radius:62% 38% 46% 54% / 60% 44% 56% 40%;mix-blend-mode:multiply;"></div>
      <!-- Lower-right zone: grey-blue -->
      <div data-blob class="ambient-shape-2" style="position:absolute;width:60vw;height:64vh;bottom:-14vh;right:-12vw;background:rgba(70,108,152,0.11);border-radius:44% 56% 38% 62% / 48% 62% 38% 52%;mix-blend-mode:multiply;"></div>
      <!-- Centre zone: warm earth -->
      <div data-blob class="ambient-shape-3" style="position:absolute;width:52vw;height:44vh;top:28vh;left:32vw;background:rgba(138,118,90,0.10);border-radius:70% 30% 58% 42% / 38% 66% 34% 62%;mix-blend-mode:multiply;"></div>
    </div>

    <header class="border-b border-[var(--color-rule)] bg-[var(--color-paper)]/85 backdrop-blur-md sticky top-0 z-20">
      <div class="mx-auto max-w-6xl px-6 py-5 flex items-baseline justify-between gap-6">
        <a href={`${base}/`} class="font-[var(--font-display)] text-xl font-bold tracking-tight">
          Julian Smith
        </a>
        <nav class="hidden md:flex gap-6 font-[var(--font-sans)] text-sm">
          {site.nav.map((item) => {
            const href = `${base}${item.href}`;
            const isActive = here.startsWith(item.href);
            return (
              <a
                href={href}
                class:list={[
                  'transition-colors',
                  isActive ? 'text-[var(--color-ink)] font-semibold' : 'text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
      </div>
      <div class="md:hidden border-t border-[var(--color-rule-soft)] bg-[var(--color-paper-warm)]/80 backdrop-blur-md">
        <nav class="mx-auto max-w-6xl px-6 py-3 flex flex-wrap gap-x-5 gap-y-1 font-[var(--font-sans)] text-xs">
          {site.nav.map((item) => (
            <a href={`${base}${item.href}`} class="text-[var(--color-ink-soft)]">{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 panel-dark">
      <div class="mx-auto max-w-6xl px-6 py-10 grid gap-8 md:grid-cols-3 font-[var(--font-sans)] text-sm">
        <div>
          <p class="font-[var(--font-display)] text-base font-bold">Julian Smith</p>
          <p class="text-[var(--color-dark-muted)] mt-1">{site.tagline}</p>
        </div>
        <div>
          <p class="eyebrow mb-2">Site</p>
          <ul class="space-y-1">
            {site.nav.map((item) => (
              <li><a href={`${base}${item.href}`} class="text-[var(--color-dark-text)] hover:underline">{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-2">Elsewhere</p>
          <ul class="space-y-1">
            {site.social.facebook ? (
              <li><a href={site.social.facebook} class="text-[var(--color-dark-text)] hover:underline" target="_blank" rel="noopener">Julian Smith plays music — Facebook</a></li>
            ) : (
              <li class="text-[var(--color-dark-muted)] italic text-xs">Facebook link to be added</li>
            )}
            {site.email && (
              <li><a href={`mailto:${site.email}`} class="text-[var(--color-dark-text)] hover:underline">{site.email}</a></li>
            )}
          </ul>
        </div>
      </div>
    </footer>
    <!-- Randomise blob positions + shapes on every page load -->
    <script is:inline>
      (function () {
        function r(min, max) { return min + Math.random() * (max - min); }
        function blobRadius() {
          var v = function () { return Math.round(r(26, 74)); };
          return v()+'% '+v()+'% '+v()+'% '+v()+'% / '+v()+'% '+v()+'% '+v()+'% '+v()+'%';
        }
        // Three loose zones keep the blobs spread across the viewport
        var zones = [
          [r(-20, 22), r(-18, 32)],   // upper-left region
          [r(22, 62),  r(24, 62)],    // lower-right region
          [r(6,  52),  r(6,  52)],    // centre region
        ];
        var blobs = document.querySelectorAll('[data-blob]');
        blobs.forEach(function (el, i) {
          el.style.left         = zones[i][0] + 'vw';
          el.style.top          = zones[i][1] + 'vh';
          el.style.right        = 'auto';
          el.style.bottom       = 'auto';
          el.style.borderRadius = blobRadius();
        });
      })();
    </script>
  </body>
</html>
