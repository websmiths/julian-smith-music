---
import '../styles/global.css';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const desc = description ?? `${site.name}: ${site.tagline}, ${site.region}.`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(base, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen">
    <header class="border-b border-[var(--color-rule)] bg-[var(--color-paper)]">
      <div class="mx-auto max-w-6xl px-6 py-5 flex items-baseline justify-between gap-6">
        <a href={`${base}/`} class="font-[var(--font-display)] text-2xl font-bold tracking-tight">
          Julian Smith<span class="text-[var(--color-muted)] font-normal italic"> · music</span>
        </a>
        <nav class="hidden md:flex gap-7 font-[var(--font-sans)] text-sm">
          {site.nav.map((item) => {
            const href = item.href === '/' ? `${base}/` : `${base}${item.href}`;
            const isActive = item.href === '/' ? here === '/' : here.startsWith(item.href);
            return (
              <a
                href={href}
                class:list={[
                  'editorial transition-opacity',
                  isActive ? 'text-[var(--color-ink)] font-semibold' : 'text-[var(--color-ink-soft)] hover:opacity-100 opacity-80',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
      </div>
      <div class="md:hidden border-t border-[var(--color-rule)] bg-[var(--color-paper-warm)]">
        <nav class="mx-auto max-w-6xl px-6 py-3 flex flex-wrap gap-x-5 gap-y-1 font-[var(--font-sans)] text-xs uppercase tracking-wider">
          {site.nav.map((item) => {
            const href = item.href === '/' ? `${base}/` : `${base}${item.href}`;
            return <a href={href} class="text-[var(--color-ink-soft)]">{item.label}</a>;
          })}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-[var(--color-rule)] bg-[var(--color-paper-warm)]">
      <div class="mx-auto max-w-6xl px-6 py-12 grid gap-8 md:grid-cols-3 font-[var(--font-sans)] text-sm">
        <div>
          <p class="font-[var(--font-display)] text-xl font-bold">Julian Smith</p>
          <p class="text-[var(--color-muted)] mt-1">{site.tagline}</p>
          <p class="text-[var(--color-muted)]">{site.region}</p>
        </div>
        <div>
          <p class="eyebrow mb-2">Site</p>
          <ul class="space-y-1">
            {site.nav.map((item) => {
              const href = item.href === '/' ? `${base}/` : `${base}${item.href}`;
              return <li><a href={href} class="editorial text-[var(--color-ink-soft)]">{item.label}</a></li>;
            })}
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-2">Notes</p>
          <p class="text-[var(--color-muted)] text-xs leading-relaxed">
            Built as an editorial archive of bands, recordings and live work. Some entries are from the pre-internet era and rely on memory; corrections welcome.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  ::selection { background: var(--color-ink); color: var(--color-paper); }
</style>
