---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BandCard from '../components/BandCard.astro';
import { site } from '../lib/site';

const bands = (await getCollection('bands')).sort((a, b) =>
  (b.data.yearStart ?? 0) - (a.data.yearStart ?? 0)
);

const featured = bands.filter((b) => b.data.featured).slice(0, 4);
const allCount = bands.length;
const roleCounts = bands.reduce<Record<string, number>>((acc, b) => {
  acc[b.data.role] = (acc[b.data.role] ?? 0) + 1;
  return acc;
}, {});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base>
  <!-- Asymmetric two-column hero with portrait slot -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-6xl px-6 py-14 grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-7">
        <h1 class="font-[var(--font-display)] font-bold text-4xl md:text-5xl leading-[1.05] tracking-tight">
          Julian Smith
        </h1>
        <p class="mt-2 font-[var(--font-display)] italic text-2xl md:text-3xl text-[var(--color-ink-soft)]">
          Bass and flute, Northern Rivers.
        </p>
        <p class="mt-6 max-w-xl text-[var(--color-ink-soft)] leading-relaxed">
          Plays in {roleCounts.core ?? 0} bands across jazz, folk, blues, funk
          and various world influences. Also subs on bass for several
          others, sessions when needed, and runs live sound.
        </p>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-[var(--font-sans)]">
          <a href={`${base}/bands`} class="text-[var(--color-ink)] border-b border-[var(--color-rule)] hover:border-[var(--color-ink)] pb-0.5">Browse the bands</a>
          <a href={`${base}/for-hire`} class="text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] pb-0.5">For hire</a>
        </div>
      </div>
      <div class="md:col-span-5">
        <div class="aspect-[4/5] bg-[var(--color-paper-deep)] border border-[var(--color-rule-soft)] overflow-hidden">
          <img src={`${base}/images/portrait.jpg`} alt="Julian Smith" class="w-full h-full object-cover" onerror="this.style.display='none'" />
        </div>
        <p class="mt-2 text-xs text-[var(--color-muted)] font-[var(--font-sans)]">
          Drop a portrait at <code>public/images/portrait.jpg</code> to fill this.
        </p>
      </div>
    </div>
  </section>

  <!-- Bio quote on dark accent panel -->
  <section class="panel-dark">
    <div class="mx-auto max-w-3xl px-6 py-12">
      <p class="eyebrow mb-4">Bio</p>
      <blockquote class="pullquote">&ldquo;{site.bio}&rdquo;</blockquote>
      {site.bioSource && (
        <p class="text-xs text-[var(--color-dark-muted)] font-[var(--font-sans)]">
          via <a href={site.bioSource.url} class="editorial">{site.bioSource.label}</a>
        </p>
      )}
    </div>
  </section>

  <!-- Featured bands + browse-by, integrated -->
  <section>
    <div class="mx-auto max-w-6xl px-6 py-14 grid md:grid-cols-12 gap-8">
      <div class="md:col-span-8">
        <div class="flex items-end justify-between mb-5 border-b border-[var(--color-rule)] pb-3">
          <h2 class="font-[var(--font-display)] text-2xl font-bold">Featured bands</h2>
          <a href={`${base}/bands`} class="font-[var(--font-sans)] text-sm text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]">All {allCount} →</a>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {featured.map((band) => <BandCard band={band} />)}
        </div>
      </div>
      <aside class="md:col-span-4 space-y-7 font-[var(--font-sans)] text-sm md:border-l md:border-[var(--color-rule)] md:pl-8">
        <div>
          <p class="eyebrow mb-2">Plays</p>
          <ul class="space-y-1 text-[var(--color-ink)]">
            <li>Double bass</li>
            <li>Electric bass</li>
            <li>Flute</li>
            <li>Hand percussion</li>
            <li>Harmony vocals</li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-2">Browse by</p>
          <ul class="space-y-1.5">
            <li><a href={`${base}/bands?role=core`} class="text-[var(--color-ink)] hover:underline">Core member <span class="text-[var(--color-muted)]">({roleCounts.core ?? 0})</span></a></li>
            <li><a href={`${base}/bands?role=sub`} class="text-[var(--color-ink)] hover:underline">Sub / stand-in <span class="text-[var(--color-muted)]">({roleCounts.sub ?? 0})</span></a></li>
            <li><a href={`${base}/bands?role=session`} class="text-[var(--color-ink)] hover:underline">Studio session <span class="text-[var(--color-muted)]">({roleCounts.session ?? 0})</span></a></li>
            <li><a href={`${base}/recordings`} class="text-[var(--color-ink)] hover:underline">Recordings</a></li>
            <li><a href={`${base}/live`} class="text-[var(--color-ink)] hover:underline">Festivals &amp; venues</a></li>
            <li><a href={`${base}/for-hire`} class="text-[var(--color-ink)] hover:underline">For hire</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>
