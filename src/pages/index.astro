---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BandCard from '../components/BandCard.astro';
import { site } from '../lib/site';

const allGigs = await getCollection('gigs');
const todayStr = new Date().toISOString().split('T')[0];
const nextGig = allGigs
  .filter(g => !g.data.cancelled && g.data.date.toISOString().split('T')[0] >= todayStr)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())[0] ?? null;

const rolePriority: Record<string, number> = { core: 3, sub: 2, session: 1, video: 0 };
const bands = (await getCollection('bands')).sort((a, b) => {
  // Bands with images first
  const aImg = a.data.image ? 1 : 0;
  const bImg = b.data.image ? 1 : 0;
  if (bImg !== aImg) return bImg - aImg;
  // Core members before subs/session/video
  const aRole = rolePriority[a.data.role] ?? 0;
  const bRole = rolePriority[b.data.role] ?? 0;
  if (bRole !== aRole) return bRole - aRole;
  // Most recently started
  return (b.data.yearStart ?? 0) - (a.data.yearStart ?? 0);
});
const featured = bands.filter((b) => b.data.featured).slice(0, 4);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sidebarLinks: { href: string; label: string }[] = [
  { href: '/bands?role=core', label: 'Core member' },
  { href: '/bands?role=sub', label: 'Sub / stand-in' },
  { href: '/bands?role=session', label: 'Studio session' },
  { href: '/bands', label: 'All bands' },
  { href: '/gigs', label: 'Gigs' },
  { href: '/recordings', label: 'Recordings' },
  { href: '/live', label: 'Festivals & venues' },
  { href: '/for-hire', label: 'For hire' },
  { href: '/about', label: 'About' },
];
---
<Base>
  <div class="mx-auto max-w-7xl grid md:grid-cols-12 md:gap-8 px-6 md:px-6 py-8">
    <!-- Dark sidebar -->
    <aside class="md:col-span-4 lg:col-span-3 md:self-start panel-dark relative overflow-hidden mb-8 md:mb-0">
      <svg class="absolute top-0 right-0 w-32 h-32 opacity-30 pointer-events-none" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="0.6" style="color: var(--color-dark-muted)">
        <path d="M120,10 C90,30 100,55 70,60 C40,65 50,90 20,100" stroke-linecap="round" />
        <path d="M120,30 C95,50 105,70 80,80" stroke-linecap="round" />
      </svg>

      <div class="relative p-6 space-y-6">
        <div>
          <h1 class="font-[var(--font-display)] text-3xl font-bold leading-tight text-[var(--color-dark-text)]">Julian Smith</h1>
          <p class="font-[var(--font-display)] italic text-lg text-[var(--color-dark-muted)] mt-1">Bass and flute, Northern Rivers.</p>
        </div>

        <div class="aspect-[4/5] bg-[var(--color-dark-soft)] border border-[var(--color-dark-soft)] overflow-hidden">
          <img src={`${base}/images/julian-smith-portrait.jpg`} alt="Julian Smith with double bass" class="w-full h-full object-cover" onerror="this.style.display='none'" />
        </div>

        <div class="font-[var(--font-sans)] text-sm">
          <p class="eyebrow mb-3">Plays</p>
          <ul class="space-y-1 text-[var(--color-dark-text)]">
            <li>Double bass <span class="text-[var(--color-dark-muted)] text-xs"> — upright</span></li>
            <li>Electric bass</li>
            <li>Flute</li>
            <li>Hand percussion</li>
            <li>Harmony vocals</li>
          </ul>
        </div>

        <nav class="font-[var(--font-sans)] text-sm">
          <p class="eyebrow mb-3">Sections</p>
          <ul class="-mx-2">
            {sidebarLinks.map((item) => (
              <li>
                <a
                  href={`${base}${item.href}`}
                  class="group flex items-baseline justify-between gap-3 px-2 py-1.5 border-b border-[var(--color-dark-soft)] hover:border-[var(--color-dark-text)] transition-colors text-[var(--color-dark-text)]"
                >
                  <span class="flex items-baseline gap-2">
                    <span class="text-[var(--color-dark-muted)] group-hover:text-[var(--color-dark-text)] transition-colors">→</span>
                    <span>{item.label}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="font-[var(--font-sans)] text-sm pt-2">
          <p class="eyebrow mb-3">Elsewhere</p>
          <ul class="space-y-1.5">
            <li>
              <a href={site.social.facebook} target="_blank" rel="noopener" class="text-[var(--color-dark-text)] hover:underline inline-flex items-center gap-2">
                <span>Julian Smith plays — Facebook</span>
                <span class="text-[var(--color-dark-muted)] text-xs">↗</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <svg class="absolute bottom-0 left-0 w-40 h-24 opacity-25 pointer-events-none" viewBox="0 0 160 96" fill="none" stroke="currentColor" stroke-width="0.6" style="color: var(--color-dark-muted)">
        <path d="M0,80 C40,90 60,40 100,55 C130,65 145,40 160,50" stroke-linecap="round" />
      </svg>
    </aside>

    <!-- Main column -->
    <div class="md:col-span-8 lg:col-span-9 min-w-0 space-y-12">

      <!-- 1. About / bio -->
      <section class="py-2 px-1">
        <p class="eyebrow mb-3">About</p>
        <p class="text-lg text-[var(--color-ink)] leading-relaxed max-w-2xl">
          Plays in a number of bands across jazz, folk, blues, funk and
          various world influences. Subs on bass for several others,
          sessions when needed, and runs live sound.
        </p>
        <p class="mt-4 text-[var(--color-ink-soft)] leading-relaxed max-w-2xl">
          {site.bio}
        </p>
      </section>

      <!-- 2. Plate I: Magnificence on graffiti wall -->
      <section class="px-1">
        <p class="eyebrow mb-3">Plate I</p>
        <figure class="m-0">
          <div class="aspect-[16/9] bg-[var(--color-paper-deep)] overflow-hidden border border-[var(--color-rule-soft)]">
            <img src={`${base}/images/magnificence-2.jpg`} alt="The Magnificence on a graffiti wall" loading="lazy" class="w-full h-full object-cover" />
          </div>
          <figcaption class="mt-3 text-sm font-[var(--font-sans)] text-[var(--color-muted)] flex items-baseline justify-between gap-4">
            <span>The Magnificence — Lismore, Northern Rivers</span>
            <a href={`${base}/bands/the-magnificence`} class="editorial">Read more →</a>
          </figcaption>
        </figure>
      </section>

      <!-- 3. Next gig (only shown when there is one) -->
      {nextGig && (
        <section class="px-1">
          <div class="border border-[var(--color-rule)] px-5 py-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <div>
              <p class="eyebrow mb-1">Next gig</p>
              <p class="font-[var(--font-display)] text-lg font-semibold leading-snug">
                {nextGig.data.venue}
                {nextGig.data.city && <span class="font-normal text-[var(--color-ink-soft)]"> — {nextGig.data.city}</span>}
              </p>
              <p class="font-[var(--font-sans)] text-sm text-[var(--color-ink-soft)] mt-0.5">
                {nextGig.data.date.toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}
                {nextGig.data.time && <> · {nextGig.data.time}</>}
                {' · '}{nextGig.data.bands.join(', ')}
              </p>
            </div>
            <a href={`${base}/gigs`} class="font-[var(--font-sans)] text-sm editorial shrink-0">All gigs →</a>
          </div>
        </section>
      )}

      <!-- 4. Featured bands grid -->
      <section class="px-1">
        <div class="flex items-end justify-between mb-5 border-b border-[var(--color-rule)] pb-3">
          <h2 class="font-[var(--font-display)] text-2xl font-bold">Featured bands</h2>
          <a href={`${base}/bands`} class="font-[var(--font-sans)] text-sm text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]">All bands →</a>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {featured.map((band) => <BandCard band={band} feature={true} />)}
        </div>
      </section>

      <!-- 4. Dark panel: image diptych on the road -->
      <section class="panel-dark py-10 px-5">
        <p class="eyebrow mb-4">On the road</p>
        <div class="grid md:grid-cols-2 gap-5">
          <figure class="m-0">
            <div class="aspect-[4/3] bg-[var(--color-dark-soft)] overflow-hidden">
              <img src={`${base}/images/blueskillet-1.jpg`} alt="The BlueSkillet Rovers in full cry" loading="lazy" class="w-full h-full object-cover" />
            </div>
            <figcaption class="mt-2 text-xs font-[var(--font-sans)] text-[var(--color-dark-muted)]">
              The BlueSkillet Rovers — Plate II
            </figcaption>
          </figure>
          <figure class="m-0">
            <div class="aspect-[4/3] bg-[var(--color-dark-soft)] overflow-hidden">
              <img src={`${base}/images/husbands-1.jpg`} alt="Sofiella & The Handsome Husbands" loading="lazy" class="w-full h-full object-cover" />
            </div>
            <figcaption class="mt-2 text-xs font-[var(--font-sans)] text-[var(--color-dark-muted)]">
              Sofiella &amp; The Handsome Husbands — Plate III
            </figcaption>
          </figure>
        </div>
      </section>

    </div>
  </div>
</Base>
