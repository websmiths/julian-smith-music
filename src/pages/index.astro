---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BandCard from '../components/BandCard.astro';
import { site } from '../lib/site';

const bands = (await getCollection('bands')).sort((a, b) =>
  (b.data.yearStart ?? 0) - (a.data.yearStart ?? 0)
);

const featured = bands.filter((b) => b.data.featured).slice(0, 4);
const allCount = bands.length;
const roleCounts = bands.reduce<Record<string, number>>((acc, b) => {
  acc[b.data.role] = (acc[b.data.role] ?? 0) + 1;
  return acc;
}, {});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base>
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-6xl px-6 pt-12 pb-8 grid md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-8">
        <p class="eyebrow mb-3">A working musician's archive · est. {new Date().getFullYear()}</p>
        <h1 class="font-[var(--font-display)] font-black text-5xl md:text-7xl leading-[0.95] tracking-tight">
          Julian Smith,<br />
          <span class="italic font-medium text-[var(--color-ink-soft)]">on bass &amp; flute &amp; whatever else.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
          Northern Rivers, NSW. Several decades on stages and in studios across jazz, folk, blues, funk and points further afield. Core member of {roleCounts.core ?? 0} bands; substitute on a few more; session work; live sound.
        </p>
      </div>
      <div class="md:col-span-4 md:text-right">
        <a href={`${base}/for-hire`} class="inline-block bg-[var(--color-ink)] text-[var(--color-paper)] px-6 py-3 font-[var(--font-sans)] text-sm uppercase tracking-widest hover:bg-[var(--color-ink-soft)] transition-colors">
          Available for hire
        </a>
        <p class="mt-3 text-xs text-[var(--color-muted)] font-[var(--font-sans)] uppercase tracking-widest">
          {allCount} projects logged
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-paper-warm)] border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-4xl px-6 py-16 text-center">
      <p class="eyebrow mb-5">In his own words</p>
      <blockquote class="font-[var(--font-display)] italic text-2xl md:text-4xl leading-snug text-[var(--color-ink)]">
        &ldquo;{site.bio}&rdquo;
      </blockquote>
      {site.bioSource && (
        <p class="mt-6 text-sm text-[var(--color-muted)] font-[var(--font-sans)]">
          via <a href={site.bioSource.url} class="editorial">{site.bioSource.label}</a>
        </p>
      )}
    </div>
  </section>

  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-6xl px-6 py-12 grid grid-cols-2 md:grid-cols-5 gap-6 text-center">
      {[
        { label: 'Double bass', sub: 'upright' },
        { label: 'Electric bass', sub: '4 / 5 string' },
        { label: 'Flute', sub: 'C / alto' },
        { label: 'Percussion', sub: 'congas / hand' },
        { label: 'Harmony vocals', sub: 'BVs' },
      ].map(({ label, sub }) => (
        <div class="py-4">
          <p class="font-[var(--font-display)] text-lg md:text-xl font-bold">{label}</p>
          <p class="mt-1 eyebrow">{sub}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="flex items-end justify-between mb-8 border-b border-[var(--color-rule)] pb-4">
        <div>
          <p class="eyebrow mb-2">Featured</p>
          <h2 class="font-[var(--font-display)] text-4xl font-bold">Bands</h2>
        </div>
        <a href={`${base}/bands`} class="editorial font-[var(--font-sans)] text-sm">See all {allCount} →</a>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {featured.map((band) => <BandCard band={band} feature={true} />)}
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-rule)] bg-[var(--color-paper-warm)]">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="eyebrow mb-2">Browse by</p>
      <h2 class="font-[var(--font-display)] text-3xl font-bold mb-8">A few ways in</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { href: '/bands?role=core', label: 'Core member', count: roleCounts.core ?? 0, blurb: 'Bands where Julian is part of the working line-up.' },
          { href: '/bands?role=sub', label: 'Sub / stand-in', count: roleCounts.sub ?? 0, blurb: 'Bands he covers when their bass player can\'t make it.' },
          { href: '/bands?role=session', label: 'Studio sessions', count: roleCounts.session ?? 0, blurb: 'Recording work — released and forthcoming.' },
          { href: '/recordings', label: 'Recordings', count: '·', blurb: 'Discography across all projects.' },
          { href: '/live', label: 'Live & festivals', count: '·', blurb: 'Festivals, venues and the long road from Lithgow to Cairns.' },
          { href: '/for-hire', label: 'For hire', count: '·', blurb: 'Genres, instruments, what to email about.' },
        ].map((item) => (
          <a href={`${base}${item.href}`} class="block p-6 border border-[var(--color-rule)] bg-[var(--color-paper)] hover:border-[var(--color-ink)] transition-colors">
            <p class="font-[var(--font-display)] text-2xl font-bold flex items-baseline gap-2">
              {item.label}
              <span class="text-sm font-normal text-[var(--color-muted)]">({item.count})</span>
            </p>
            <p class="mt-2 text-sm text-[var(--color-ink-soft)] leading-snug">{item.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
