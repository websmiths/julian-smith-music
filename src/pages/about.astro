---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';

const bands = await getCollection('bands');
const counts = bands.reduce<Record<string, number>>((acc, b) => {
  acc[b.data.role] = (acc[b.data.role] ?? 0) + 1;
  return acc;
}, {});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="About" description="Bass and flute, Northern Rivers — about Julian Smith.">
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-6xl px-6 py-14">
      <p class="eyebrow mb-3">About</p>
      <h1 class="font-[var(--font-display)] font-bold text-5xl md:text-6xl leading-tight">Julian Smith</h1>
    </div>
  </section>

  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-3xl px-6 py-14 space-y-6 text-[var(--color-ink)] leading-relaxed">
      <p>
        Based in the Northern Rivers, NSW. Plays mainly basses and flute,
        with regular work across jazz, folk, blues, funk, gypsy swing,
        Hawaiian hapa haole, cosmic country, and an Afrobeat band that
        calls itself Timbuktu.
      </p>

      <blockquote class="pullquote">
        &ldquo;{site.bio}&rdquo;
        <footer class="mt-3 text-xs not-italic font-[var(--font-sans)] text-[var(--color-muted)]">
          {site.bioSource && <>via <a href={site.bioSource.url} class="editorial">{site.bioSource.label}</a></>}
        </footer>
      </blockquote>

      <p>
        Core member of {counts.core ?? 0} bands; substitute on bass for several
        others when their regular player can't make it; studio session
        work; live sound when needed.
      </p>

      <p>
        Long-running collaborators include the Funkafide Productions
        circle (Miss Jodie Digney, Matt Elliott), Cameron Smith and Joe
        O'Keeffe at the New Orleans / Afrobeat end, and recording
        engineer Andy Downer at A.D Studio in Lismore.
      </p>
    </div>
  </section>

  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-6xl px-6 py-10 grid grid-cols-2 md:grid-cols-4 gap-6">
      {[
        { n: counts.core ?? 0, l: 'Core bands' },
        { n: counts.sub ?? 0, l: 'Subs' },
        { n: counts.session ?? 0, l: 'Sessions' },
        { n: bands.length, l: 'Projects logged' },
      ].map((s) => (
        <div class="border-t border-[var(--color-rule)] pt-3">
          <p class="font-[var(--font-display)] text-4xl font-bold text-[var(--color-ink)]">{s.n}</p>
          <p class="eyebrow mt-1">{s.l}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-6 py-10 text-[var(--color-ink-soft)] text-sm leading-relaxed">
      <p class="eyebrow mb-3">Note on the archive</p>
      <p>
        Some entries are well-documented online. Others, particularly
        the early-1990s Bathurst-era bands and short-lived Northern
        Rivers projects, survive mostly as memory and personal records.
        If you have photos, recordings or notes from any of these,
        please <a href={`${base}/for-hire`} class="editorial">get in touch</a>.
      </p>
    </div>
  </section>
</Base>
