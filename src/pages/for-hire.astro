---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="For hire" description="Subbing, session and live work — Northern Rivers and beyond.">
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-6xl px-6 py-14">
      <p class="eyebrow mb-3">For hire</p>
      <h1 class="font-[var(--font-display)] font-bold text-5xl md:text-6xl leading-tight">Available</h1>
      <p class="mt-4 max-w-2xl text-[var(--color-ink-soft)] leading-relaxed">
        Live gigs, festivals, recording sessions, one-off subs. Based in
        the Northern Rivers, NSW; happy to travel.
      </p>
    </div>
  </section>

  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-6xl px-6 py-12 grid md:grid-cols-3 gap-10">
      <div>
        <p class="eyebrow mb-3">Instruments</p>
        <ul class="space-y-1.5 font-[var(--font-display)] text-lg text-[var(--color-ink)]">
          <li>Double bass <span class="text-xs font-[var(--font-sans)] text-[var(--color-muted)]">— upright</span></li>
          <li>Electric bass <span class="text-xs font-[var(--font-sans)] text-[var(--color-muted)]">— 4 / 5 string</span></li>
          <li>Flute <span class="text-xs font-[var(--font-sans)] text-[var(--color-muted)]">— C, alto</span></li>
          <li>Hand percussion <span class="text-xs font-[var(--font-sans)] text-[var(--color-muted)]">— congas</span></li>
          <li>Harmony vocals</li>
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-3">Comfortable in</p>
        <ul class="space-y-1.5 font-[var(--font-display)] text-lg text-[var(--color-ink)]">
          <li>Trad &amp; modern jazz</li>
          <li>Folk, bluegrass, old-time</li>
          <li>Funk &amp; blues</li>
          <li>Gypsy swing</li>
          <li>Country, Americana, cosmic country</li>
          <li>Afrobeat &amp; world</li>
          <li>Hawaiian hapa haole</li>
          <li>Cajun / zydeco</li>
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-3">Useful for</p>
        <ul class="space-y-1.5 font-[var(--font-display)] text-lg text-[var(--color-ink)]">
          <li>Subs when your bass player can't make it</li>
          <li>Studio sessions — bass &amp; flute</li>
          <li>Festival pickup bands</li>
          <li>Live sound for small-to-mid-format gigs</li>
        </ul>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-6 py-14">
      <p class="eyebrow mb-3">Get in touch</p>
      {site.email ? (
        <p>
          <a href={`mailto:${site.email}`} class="font-[var(--font-display)] text-2xl editorial">
            {site.email}
          </a>
        </p>
      ) : (
        <p class="text-[var(--color-muted)] italic">Email address to be added.</p>
      )}
      {site.social.facebook && (
        <p class="mt-3 text-sm font-[var(--font-sans)]">
          Or message <a href={site.social.facebook} target="_blank" rel="noopener" class="editorial">Julian Smith plays music</a> on Facebook.
        </p>
      )}
      <p class="mt-8 text-sm text-[var(--color-ink-soft)] leading-relaxed">
        For a sense of what I sound like in different contexts, the <a href={`${base}/recordings`} class="editorial">recordings</a> page collects releases across every band; the <a href={`${base}/bands`} class="editorial">bands</a> page lets you browse by genre and role.
      </p>
    </div>
  </section>
</Base>
