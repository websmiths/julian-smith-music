---
import { getCollection } from 'astro:content';
const bands = (await getCollection('bands'))
  .filter((b) => b.data.featured || ['blueskillet-rovers','sofiella-handsome-husbands','timbuktu','davey-bobs-blue-healers','bassix','the-magnificence','the-hoochers'].includes(b.id))
  .sort((a, b) => (b.data.yearStart ?? 0) - (a.data.yearStart ?? 0));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Map images to bands (manual for the preview)
const imageMap: Record<string, string> = {
  'the-magnificence': '/images/magnificence-1.jpg',
  'bassix': '/images/bassix-1.jpg',
  'the-hoochers': '/images/blueskillet-1.jpg',
  'blueskillet-rovers': '/images/blueskillet-1.jpg',
  'sofiella-handsome-husbands': '/images/husbands-1.jpg',
  'jam-tart': '/images/jam-tart.jpg',
  'stagger-juice': '/images/stagger-juice.jpg',
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Preview · Liner notes — Julian Smith</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Special+Elite&family=Crimson+Pro:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --paper: #ece4cf;
      --paper-shadow: #d8cfb6;
      --ink: #1a1612;
      --ink-soft: #3a342a;
      --rust: #8a3324;
      --grain: rgba(26,22,18,0.04);
    }
    html, body { background: var(--paper); color: var(--ink); margin: 0; font-family: 'Crimson Pro', Georgia, serif; }
    body {
      background-image:
        radial-gradient(circle at 30% 20%, rgba(0,0,0,0.025) 0%, transparent 60%),
        radial-gradient(circle at 70% 80%, rgba(0,0,0,0.03) 0%, transparent 60%);
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 100;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.7'/></svg>");
      opacity: 0.06;
      mix-blend-mode: multiply;
    }
    .display { font-family: 'Anton', Impact, sans-serif; letter-spacing: 0.01em; }
    .typewriter { font-family: 'Special Elite', monospace; }
    .serif { font-family: 'Crimson Pro', Georgia, serif; }
    .catalog {
      font-family: 'Special Elite', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }
    .plate-caption {
      font-family: 'Special Elite', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      color: var(--ink-soft);
      border-top: 1px solid var(--ink);
      padding-top: 0.4rem;
      margin-top: 0.4rem;
    }
    .rule { border: 0; height: 1px; background: var(--ink); }
    .double-rule {
      border-top: 1px solid var(--ink);
      border-bottom: 4px double var(--ink);
      padding-block: 0.5rem;
    }
    .number-bullet {
      font-family: 'Anton', sans-serif;
      font-size: 1.2rem;
      color: var(--rust);
      width: 2rem;
      flex-shrink: 0;
    }
    a { color: inherit; }
  </style>
</head>
<body>
  <!-- Top bar / metadata -->
  <div style="border-bottom: 1px solid var(--ink); background: var(--paper);">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0.6rem 1.5rem; display: flex; justify-content: space-between; align-items: baseline; gap: 2rem;">
      <span class="catalog">Cat. № JS-001 · LP / WEB</span>
      <span class="catalog">Side A · Northern Rivers, NSW</span>
      <span class="catalog">2026 · pressed to no specific medium</span>
    </div>
  </div>

  <!-- Sleeve hero: full-bleed image with cropped giant type -->
  <section style="position: relative; max-width: 1280px; margin: 0 auto; border-bottom: 1px solid var(--ink);">
    <div style="position: relative; height: clamp(420px, 75vh, 720px); overflow: hidden;">
      <img src={`${base}/images/magnificence-1.jpg`} alt="The Magnificence" style="width: 100%; height: 100%; object-fit: cover; object-position: center 40%; filter: sepia(0.3) contrast(1.05);" />
      <!-- title sits in bottom -->
      <div style="position: absolute; left: 0; right: 0; bottom: 0; padding: 1.5rem 2rem; background: linear-gradient(to top, rgba(236,228,207,0.95) 30%, transparent);">
        <p class="catalog" style="margin: 0 0 0.3rem; color: var(--rust);">Plate I — The Magnificence at the Conservatorium</p>
      </div>
    </div>
  </section>

  <!-- Big nameplate that crosses the boundary -->
  <section style="position: relative; max-width: 1280px; margin: 0 auto; padding: 0;">
    <div style="position: relative; padding: 2rem 2rem 0;">
      <h1 class="display" style="font-size: clamp(5rem, 16vw, 13rem); line-height: 0.82; margin: 0; text-transform: uppercase; color: var(--ink); white-space: nowrap; letter-spacing: -0.015em;">
        Julian<br/>
        <span style="display: inline-block; padding-left: 1.5em;">Smith</span>
      </h1>
    </div>
    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0; border-top: 4px double var(--ink); border-bottom: 1px solid var(--ink); margin-top: 1rem;">
      <div style="padding: 1rem 2rem; border-right: 1px solid var(--ink);">
        <p class="catalog">Side A</p>
        <p class="display" style="font-size: 1.4rem; margin: 0.2rem 0 0; text-transform: uppercase;">Bass</p>
      </div>
      <div style="padding: 1rem 2rem; border-right: 1px solid var(--ink);">
        <p class="catalog">Side B</p>
        <p class="display" style="font-size: 1.4rem; margin: 0.2rem 0 0; text-transform: uppercase;">Flute</p>
      </div>
      <div style="padding: 1rem 2rem;">
        <p class="catalog">B-side &amp; rarities</p>
        <p class="display" style="font-size: 1.4rem; margin: 0.2rem 0 0; text-transform: uppercase;">&amp; whatever else</p>
      </div>
    </div>
  </section>

  <!-- Liner-notes column + plate -->
  <section style="max-width: 1280px; margin: 0 auto; padding: 3rem 2rem 0; display: grid; grid-template-columns: 7fr 5fr; gap: 3rem;">
    <div>
      <p class="typewriter" style="font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--rust); margin: 0 0 0.4rem;">— Liner Notes —</p>
      <p class="serif" style="font-size: 1.25rem; line-height: 1.55; margin: 0 0 1rem; max-width: 38rem;">
        <span class="display" style="font-size: 4rem; float: left; line-height: 0.85; padding: 0.4rem 0.6rem 0 0; color: var(--rust);">P</span>lays mainly basses and flute, with regular work across funk, folk, blues, jazz, latin and various world influences. Anything with harmony and groove. Northern Rivers, NSW; happy to travel.
      </p>
      <p class="serif" style="font-size: 1.05rem; line-height: 1.6; color: var(--ink-soft); max-width: 36rem;">
        Plays in a number of bands as core member, subs on bass for a few more, sessions when needed, runs live sound. Long-running collaborators include the Funkafide circle (Miss Jodie Digney, Matt Elliott), Cameron Smith and Joe O'Keeffe at the New Orleans / Afrobeat end, Davey Bob Ramsey on banjo.
      </p>
    </div>
    <div style="border: 1px solid var(--ink); padding: 0.6rem;">
      <img src={`${base}/images/julian-smith-portrait.jpg`} alt="Julian" style="display: block; width: 100%; aspect-ratio: 4/5; object-fit: cover; filter: sepia(0.15) contrast(1.05);" />
      <p class="plate-caption">Plate II — Studio, double bass, take II</p>
    </div>
  </section>

  <!-- Track listing: bands as numbered sleeve credits -->
  <section style="max-width: 1280px; margin: 0 auto; padding: 4rem 2rem 5rem;">
    <div style="display: flex; align-items: baseline; justify-content: space-between; border-bottom: 4px double var(--ink); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
      <h2 class="display" style="font-size: 2.6rem; margin: 0; text-transform: uppercase;">Track Listing</h2>
      <p class="catalog">Bands, in rotation</p>
    </div>

    <ol style="list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0;">
      {bands.slice(0, 8).map((band, i) => {
        const num = String(i + 1).padStart(2, '0');
        const img = imageMap[band.id];
        return (
          <li style={`display: grid; grid-template-columns: 80px 1fr; gap: 1rem; padding: 1rem 1.2rem; border-bottom: 1px solid var(--ink); ${i % 2 === 0 ? 'border-right: 1px solid var(--ink);' : ''}`}>
            <div>
              {img ? (
                <img src={`${base}${img}`} alt="" style="width: 80px; height: 80px; object-fit: cover; filter: sepia(0.2) contrast(1.05);" />
              ) : (
                <div style="width: 80px; height: 80px; background: var(--paper-shadow); display: flex; align-items: center; justify-content: center;">
                  <span class="display" style="font-size: 1.6rem; color: var(--ink);">{num}</span>
                </div>
              )}
            </div>
            <div>
              <p class="display" style="font-size: 1.4rem; margin: 0; text-transform: uppercase; line-height: 1;">
                <span style="color: var(--rust); margin-right: 0.4rem;">{num}</span>
                {band.data.name}
              </p>
              <p class="typewriter" style="font-size: 0.72rem; margin: 0.3rem 0; color: var(--ink-soft);">
                {band.data.julianRole.toUpperCase()} · {band.data.era}
              </p>
              <p class="serif" style="font-size: 0.92rem; margin: 0.2rem 0 0; line-height: 1.4; color: var(--ink-soft);">
                {band.data.blurb.slice(0, 120)}{band.data.blurb.length > 120 ? '…' : ''}
              </p>
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- Footer -->
  <footer style="border-top: 4px double var(--ink); margin-top: 0; background: var(--paper);">
    <div style="max-width: 1280px; margin: 0 auto; padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: baseline;">
      <p class="catalog">Cat. № JS-001 · pressed at home</p>
      <p class="catalog">Bookings: facebook.com/JulianSmithPlays</p>
    </div>
  </footer>
</body>
</html>
