---
import { getCollection } from 'astro:content';
const bands = await getCollection('bands');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Hand-picked tile order with images and sizes
const tiles: { id: string; img?: string; size: 'lg' | 'md' | 'sm' | 'wide' | 'tall' }[] = [
  { id: 'the-magnificence', img: '/images/magnificence-1.jpg', size: 'lg' },
  { id: 'sofiella-handsome-husbands', img: '/images/husbands-1.jpg', size: 'wide' },
  { id: 'blueskillet-rovers', img: '/images/blueskillet-1.jpg', size: 'md' },
  { id: 'stagger-juice', img: '/images/stagger-juice.jpg', size: 'md' },
  { id: 'bassix', img: '/images/bassix-1.jpg', size: 'tall' },
  { id: 'jam-tart', img: '/images/jam-tart.jpg', size: 'wide' },
  { id: 'the-hoochers', img: '/images/blueskillet-1.jpg', size: 'md' },
  { id: 'the-magnificence', img: '/images/magnificence-3.jpg', size: 'md' },
];
const bandById = Object.fromEntries(bands.map((b) => [b.id, b]));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Preview · Photo wall — Julian Smith</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,700;1,6..72,400;1,6..72,500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #0e0d0b;
      --paper: #faf6ec;
      --muted: #6b6354;
      --accent: #c46a17;
    }
    html, body {
      background: var(--ink);
      color: var(--paper);
      margin: 0;
      font-family: 'Space Grotesk', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .display { font-family: 'Newsreader', Georgia, serif; }
    .grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: 120px;
      gap: 6px;
      padding: 6px;
    }
    .tile {
      position: relative;
      overflow: hidden;
      background: #1a1816;
      cursor: pointer;
      transition: transform 0.4s cubic-bezier(0.2,0.7,0.3,1);
    }
    .tile img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: filter 0.5s ease, transform 0.6s ease;
      filter: grayscale(0.2) brightness(0.85) contrast(1.05);
    }
    .tile:hover img {
      filter: grayscale(0) brightness(1) contrast(1.05);
      transform: scale(1.04);
    }
    .tile-label {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      padding: 1rem 1.2rem;
      background: linear-gradient(to top, rgba(14,13,11,0.9) 0%, transparent 100%);
      transform: translateY(20%);
      opacity: 0;
      transition: transform 0.4s ease, opacity 0.4s ease;
    }
    .tile:hover .tile-label { transform: translateY(0); opacity: 1; }
    .tile-name {
      font-family: 'Newsreader', serif;
      font-size: 1.6rem;
      line-height: 1;
      margin: 0;
    }
    .tile-meta {
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0.4rem 0 0;
    }
    .lg { grid-column: span 7; grid-row: span 4; }
    .wide { grid-column: span 5; grid-row: span 2; }
    .tall { grid-column: span 4; grid-row: span 4; }
    .md { grid-column: span 4; grid-row: span 2; }
    .sm { grid-column: span 3; grid-row: span 2; }

    /* Identity card sits over the wall */
    .identity {
      position: fixed;
      top: 1.5rem;
      left: 1.5rem;
      z-index: 50;
      padding: 1rem 1.2rem;
      background: rgba(14,13,11,0.85);
      backdrop-filter: blur(6px);
      border: 1px solid rgba(250,246,236,0.15);
      max-width: 280px;
    }
    .identity .name {
      font-family: 'Newsreader', serif;
      font-size: 1.4rem;
      font-weight: 500;
      margin: 0;
      letter-spacing: -0.01em;
    }
    .identity .tag {
      font-family: 'Newsreader', serif;
      font-style: italic;
      font-size: 0.95rem;
      color: var(--muted);
      margin: 0.2rem 0 0.6rem;
    }
    .identity nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 0.8rem;
      font-size: 0.75rem;
      letter-spacing: 0.04em;
    }
    .identity nav a {
      color: var(--paper);
      text-decoration: none;
      border-bottom: 1px solid rgba(250,246,236,0.25);
      padding-bottom: 1px;
    }
    .identity nav a:hover { border-color: var(--accent); color: var(--accent); }

    .footer-strip {
      padding: 3rem 1.5rem 5rem;
      max-width: 1280px;
      margin: 0 auto;
    }
    .footer-strip h2 {
      font-family: 'Newsreader', serif;
      font-style: italic;
      font-weight: 400;
      font-size: clamp(2rem, 5vw, 3rem);
      line-height: 1.1;
      margin: 0 0 1rem;
      max-width: 18ch;
      color: var(--paper);
    }
    .footer-strip p {
      max-width: 36rem;
      color: var(--muted);
      line-height: 1.55;
    }
  </style>
</head>
<body>
  <aside class="identity">
    <p class="name">Julian Smith</p>
    <p class="tag">Bass and flute, Northern Rivers</p>
    <nav>
      <a href="#">Bands</a>
      <a href="#">Recordings</a>
      <a href="#">Live</a>
      <a href="#">For hire</a>
      <a href="#">About</a>
    </nav>
  </aside>

  <main class="grid">
    {tiles.map((t) => {
      const band = bandById[t.id];
      if (!band) return null;
      return (
        <a href="#" class={`tile ${t.size}`}>
          <img src={`${base}${t.img}`} alt={band.data.name} />
          <div class="tile-label">
            <p class="tile-name">{band.data.name}</p>
            <p class="tile-meta">{band.data.julianRole}</p>
          </div>
        </a>
      );
    })}
  </main>

  <section class="footer-strip">
    <h2>Plays mainly basses and flute, with regular work across funk, folk, blues, jazz, latin and various world influences.</h2>
    <p>Anything with harmony and groove. Subs on bass for several bands when their regular player can't make it; sessions when needed; live sound. Northern Rivers, NSW; happy to travel.</p>
  </section>
</body>
</html>
