---
import { getCollection } from 'astro:content';
const bands = (await getCollection('bands'))
  .sort((a, b) => (b.data.yearStart ?? 0) - (a.data.yearStart ?? 0));
const featured = bands.filter((b) => b.data.featured);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Preview · Tabloid — Julian Smith</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&family=Oswald:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --paper: #f3eee2;
      --paper-edge: #d8d0bd;
      --ink: #14110b;
      --ink-soft: #4a3f30;
      --muted: #6e6452;
      --rule: #1a1610;
      --red: #8a2018;
    }
    html, body { background: var(--paper); color: var(--ink); margin: 0; font-family: 'Old Standard TT', 'Times New Roman', serif; }
    body {
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/></svg>");
      background-size: 160px;
    }
    .display { font-family: 'Oswald', Impact, sans-serif; font-weight: 600; letter-spacing: 0.005em; }
    .mast { font-family: 'Old Standard TT', serif; font-weight: 700; letter-spacing: -0.01em; }
    .mono { font-family: 'IBM Plex Mono', monospace; }
    .meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .rule-thick { border: 0; border-top: 6px solid var(--ink); }
    .rule-thin { border: 0; border-top: 1px solid var(--ink); }
    .double { border-top: 1px solid var(--ink); border-bottom: 4px double var(--ink); padding: 0.4rem 0; }
    .photo {
      filter: grayscale(0.85) contrast(1.05);
    }
    .photo-caption {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      color: var(--ink-soft);
      padding: 0.5rem 0;
      border-top: 1px solid var(--ink);
      margin: 0;
    }
    .columns-3 {
      column-count: 3;
      column-gap: 1.5rem;
      column-rule: 1px solid var(--ink);
    }
    .columns-2 {
      column-count: 2;
      column-gap: 1.5rem;
      column-rule: 1px solid var(--ink);
    }
    a { color: inherit; }
  </style>
</head>
<body>
  <div style="max-width: 1280px; margin: 0 auto; padding: 1rem 1.5rem 3rem;">

    <!-- Masthead -->
    <header style="border-bottom: 6px solid var(--ink); padding-bottom: 0.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 0.6rem;">
        <span class="meta">Vol. 01 · No. 1</span>
        <span class="meta">Northern Rivers · NSW</span>
        <span class="meta">A working musician's notebook</span>
      </div>
      <hr class="rule-thin" />
      <h1 class="mast" style="font-size: clamp(4rem, 11vw, 9rem); line-height: 0.9; margin: 0.4rem 0 0.4rem; text-align: center;">
        Julian Smith
      </h1>
      <hr class="rule-thin" />
      <p style="text-align: center; font-style: italic; font-size: 1.2rem; margin: 0.5rem 0 0; font-family: 'Old Standard TT', serif;">
        Bass &amp; flute &middot; sessions &middot; live sound &middot; subs welcome
      </p>
    </header>

    <hr class="rule-thick" style="margin: 0.7rem 0 1.5rem;" />

    <!-- Lead story: big photo + headline + 2-col body -->
    <section style="display: grid; grid-template-columns: 7fr 5fr; gap: 1.5rem; padding-bottom: 1.5rem;">
      <div>
        <p class="meta" style="color: var(--red); margin: 0 0 0.3rem;">Lead · Plate I</p>
        <h2 class="display" style="font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 0.95; text-transform: uppercase; margin: 0 0 1rem;">
          Six musicians, one&nbsp;arched window
        </h2>
        <div class="columns-2" style="font-size: 1rem; line-height: 1.55;">
          <p style="margin-top: 0;">
            <span class="display" style="font-size: 3rem; float: left; line-height: 0.85; padding: 0.3rem 0.55rem 0 0; color: var(--red);">A</span>
            New Orleans jazz outfit out of Lismore, formed 2017, with three releases on Bandcamp and airplay reaching as far as WWOZ in New Orleans. Cameron Smith on trumpet, Lachi Smith on drums, Paul Edwards on reeds, Joe O'Keeffe on banjo, Julian Smith on double bass and backing vocals.
          </p>
          <p>
            Recorded at the Northern Rivers Conservatorium in Lismore and at The Barn Studio in Plainland, Queensland. Played from Brisbane Jazz Club to Powerhouse Toowoomba and Black Mountain Unplugged (twice). Bookings welcome.
          </p>
        </div>
      </div>
      <figure style="margin: 0;">
        <img src={`${base}/images/magnificence-1.jpg`} alt="The Magnificence" class="photo" style="width: 100%; aspect-ratio: 3/4; object-fit: cover;" />
        <p class="photo-caption">The Magnificence, Lismore. Print 69/119.</p>
      </figure>
    </section>

    <hr class="rule-thick" />

    <!-- Three column section: bio + portrait + bands index -->
    <section style="display: grid; grid-template-columns: 5fr 4fr 5fr; gap: 1.5rem; padding: 1.5rem 0;">
      <!-- Column 1: bio -->
      <div>
        <p class="meta" style="color: var(--red); margin: 0 0 0.3rem;">By his own account</p>
        <h3 class="display" style="font-size: 1.6rem; margin: 0 0 0.5rem; text-transform: uppercase;">Plays mainly basses and flute</h3>
        <p style="font-size: 0.95rem; line-height: 1.55; margin: 0 0 0.75rem;">
          ...with regular work across funk, folk, blues, jazz, latin and various world influences. Anything with harmony and groove.
        </p>
        <p style="font-size: 0.95rem; line-height: 1.55; margin: 0 0 0.75rem;">
          Plays in a number of bands as core member, subs on bass for a few more, sessions when needed, runs live sound. Northern Rivers, NSW; happy to travel.
        </p>
        <p class="meta" style="margin-top: 1rem;">— Bookings via <a href="https://www.facebook.com/JulianSmithPlays" style="border-bottom: 1px solid var(--ink);">facebook.com/JulianSmithPlays</a></p>
      </div>
      <!-- Column 2: portrait -->
      <figure style="margin: 0;">
        <img src={`${base}/images/julian-smith-portrait.jpg`} alt="Julian Smith" class="photo" style="width: 100%; aspect-ratio: 4/5; object-fit: cover;" />
        <p class="photo-caption">Studio, double bass, take II.</p>
      </figure>
      <!-- Column 3: classified-style band index -->
      <div>
        <p class="meta" style="color: var(--red); margin: 0 0 0.3rem;">Classifieds · Bands</p>
        <h3 class="display" style="font-size: 1.6rem; margin: 0 0 0.6rem; text-transform: uppercase;">In rotation</h3>
        <ul style="list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--ink);">
          {bands.slice(0, 9).map((b) => (
            <li style="padding: 0.45rem 0; border-bottom: 1px solid var(--ink); display: flex; gap: 0.5rem; font-size: 0.85rem; line-height: 1.3;">
              <span class="display" style={`min-width: 1.4rem; color: ${b.data.confirmed ? 'var(--ink)' : 'var(--muted)'};`}>·</span>
              <span style="flex: 1;">
                <span class="display" style="text-transform: uppercase;">{b.data.name}</span>
                <span class="meta" style="display: block; color: var(--muted); margin-top: 0.1rem;">{b.data.julianRole.toLowerCase()} · {b.data.era}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <hr class="rule-thick" />

    <!-- Photo strip: secondary plates -->
    <section style="display: grid; grid-template-columns: 4fr 5fr 3fr; gap: 1.5rem; padding: 1.5rem 0;">
      <figure style="margin: 0;">
        <img src={`${base}/images/blueskillet-1.jpg`} alt="The BlueSkillet Rovers" class="photo" style="width: 100%; aspect-ratio: 4/3; object-fit: cover;" />
        <p class="photo-caption">Plate II — The BlueSkillet Rovers in full cry.</p>
      </figure>
      <figure style="margin: 0;">
        <img src={`${base}/images/husbands-1.jpg`} alt="Sofiella & The Handsome Husbands" class="photo" style="width: 100%; aspect-ratio: 5/3; object-fit: cover;" />
        <p class="photo-caption">Plate III — Sofiella &amp; The Handsome Husbands at the bar.</p>
      </figure>
      <figure style="margin: 0;">
        <img src={`${base}/images/stagger-juice.jpg`} alt="Stagger Juice" class="photo" style="width: 100%; aspect-ratio: 1/1; object-fit: cover;" />
        <p class="photo-caption">Plate IV — Stagger Juice, jug-band insignia.</p>
      </figure>
    </section>

    <hr class="rule-thick" />

    <!-- Footer -->
    <footer style="padding: 1rem 0 0; display: flex; justify-content: space-between; align-items: baseline;">
      <p class="meta">Cat. № JS-001 · printed at home · MMXXVI</p>
      <p class="meta">facebook.com/JulianSmithPlays</p>
    </footer>
  </div>
</body>
</html>
