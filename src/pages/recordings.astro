---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const bands = await getCollection('bands');

type Entry = {
  band: string;
  bandId: string;
  title: string;
  year?: number;
  type?: string;
  notes?: string;
  bandcamp?: string;
  spotify?: string;
  tidal?: string;
};

const all: Entry[] = bands.flatMap((b) =>
  (b.data.discography ?? [])
    .filter((d) => d.julianOn !== false)
    .map((d) => ({
      band: b.data.name,
      bandId: b.id,
      title: d.title,
      year: d.year,
      type: d.type,
      notes: d.notes,
      bandcamp: d.bandcamp,
      spotify: d.spotify ?? b.data.links?.spotify,
      tidal: d.tidal ?? b.data.links?.tidal,
    }))
);

const sorted = all.sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const grouped = sorted.reduce<Record<string, Entry[]>>((acc, e) => {
  const key = e.year ? String(e.year) : 'Year unconfirmed';
  (acc[key] ??= []).push(e);
  return acc;
}, {});
const keys = Object.keys(grouped).sort((a, b) => {
  if (a === 'Year unconfirmed') return 1;
  if (b === 'Year unconfirmed') return -1;
  return Number(b) - Number(a);
});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Recordings" description="Discography across every band Julian has played in.">
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-6xl px-6 py-14">
      <p class="eyebrow mb-3">Recordings</p>
      <h1 class="font-[var(--font-display)] font-bold text-5xl md:text-6xl leading-tight">Discography</h1>
      <p class="mt-4 max-w-2xl text-lg text-[var(--color-ink-soft)] leading-relaxed">
        Releases I've played on, ordered by year. Bandcamp links where available; many older live and self-released tapes are in personal collections only.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-6 py-12 space-y-10">
      {keys.map((year) => (
        <div>
          <div class="flex items-baseline gap-4 mb-3 border-b border-[var(--color-rule)] pb-2">
            <h2 class="font-[var(--font-display)] text-3xl font-bold text-[var(--color-ink)]">{year}</h2>
            <p class="eyebrow">{grouped[year].length} {grouped[year].length === 1 ? 'release' : 'releases'}</p>
          </div>
          <ul class="divide-y divide-[var(--color-rule)]">
            {grouped[year].map((e) => (
              <li class="grid md:grid-cols-12 gap-4 py-3.5 items-baseline">
                <div class="md:col-span-5">
                  <p class="font-[var(--font-display)] text-xl font-semibold leading-tight text-[var(--color-ink)]">{e.title}</p>
                  <div class="flex flex-wrap gap-2 mt-1.5 items-center">
                    {e.type && <span class="eyebrow">{e.type}</span>}
                    {e.bandcamp && <a href={e.bandcamp} target="_blank" rel="noopener" class="text-[10px] font-[var(--font-sans)] uppercase tracking-widest border border-[var(--color-rule)] px-1.5 py-0.5 hover:border-[var(--color-ink)] hover:text-[var(--color-ink)] text-[var(--color-muted)] transition-colors">Bandcamp</a>}
                    {e.spotify && <a href={e.spotify} target="_blank" rel="noopener" class="text-[10px] font-[var(--font-sans)] uppercase tracking-widest border border-[var(--color-rule)] px-1.5 py-0.5 hover:border-[var(--color-ink)] hover:text-[var(--color-ink)] text-[var(--color-muted)] transition-colors">Spotify</a>}
                    {e.tidal && <a href={e.tidal} target="_blank" rel="noopener" class="text-[10px] font-[var(--font-sans)] uppercase tracking-widest border border-[var(--color-rule)] px-1.5 py-0.5 hover:border-[var(--color-ink)] hover:text-[var(--color-ink)] text-[var(--color-muted)] transition-colors">Tidal</a>}
                  </div>
                </div>
                <div class="md:col-span-4">
                  <a href={`${base}/bands/${e.bandId}`} class="text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] font-[var(--font-sans)] text-sm">
                    {e.band}
                  </a>
                </div>
                <div class="md:col-span-3 text-xs text-[var(--color-muted)]">
                  {e.notes && <p class="leading-snug">{e.notes}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>
