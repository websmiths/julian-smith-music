---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const bands = await getCollection('bands');

type Entry = {
  band: string;
  bandId: string;
  title: string;
  year?: number;
  type?: string;
  notes?: string;
  bandcamp?: string;
  spotify?: string;
};

const all: Entry[] = bands.flatMap((b) =>
  (b.data.discography ?? [])
    .filter((d) => d.julianOn !== false)
    .map((d) => ({
      band: b.data.name,
      bandId: b.id,
      title: d.title,
      year: d.year,
      type: d.type,
      notes: d.notes,
      bandcamp: d.bandcamp,
      spotify: d.spotify,
    }))
);

const sorted = all.sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const grouped = sorted.reduce<Record<string, Entry[]>>((acc, e) => {
  const key = e.year ? String(e.year) : 'Year unconfirmed';
  (acc[key] ??= []).push(e);
  return acc;
}, {});
const keys = Object.keys(grouped).sort((a, b) => {
  if (a === 'Year unconfirmed') return 1;
  if (b === 'Year unconfirmed') return -1;
  return Number(b) - Number(a);
});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Recordings" description="Discography across every band Julian has played in.">
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-6xl px-6 pt-12 pb-8">
      <p class="eyebrow mb-3">The shelf</p>
      <h1 class="font-[var(--font-display)] font-black text-5xl md:text-6xl leading-tight">Recordings</h1>
      <p class="mt-4 max-w-2xl text-lg text-[var(--color-ink-soft)]">
        Releases across every band, ordered by year. {sorted.length} entries logged so far. Bandcamp links where available; many older live and self-released tapes survive only in personal collections.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-6 py-12 space-y-12">
      {keys.map((year) => (
        <div>
          <div class="flex items-baseline gap-4 mb-4 border-b border-[var(--color-rule)] pb-2">
            <h2 class="font-[var(--font-display)] text-3xl font-bold">{year}</h2>
            <p class="eyebrow">{grouped[year].length} {grouped[year].length === 1 ? 'release' : 'releases'}</p>
          </div>
          <ul class="divide-y divide-[var(--color-rule)]">
            {grouped[year].map((e) => (
              <li class="grid md:grid-cols-12 gap-4 py-4 items-baseline">
                <div class="md:col-span-5">
                  <p class="font-[var(--font-display)] text-xl font-bold leading-tight">
                    {e.bandcamp ? <a href={e.bandcamp} class="editorial">{e.title}</a> : e.title}
                  </p>
                  {e.type && <p class="eyebrow mt-1">{e.type}</p>}
                </div>
                <div class="md:col-span-4">
                  <a href={`${base}/bands/${e.bandId}`} class="editorial text-[var(--color-ink-soft)] font-[var(--font-sans)] text-sm">
                    {e.band}
                  </a>
                </div>
                <div class="md:col-span-3 text-sm text-[var(--color-muted)]">
                  {e.notes && <p class="leading-snug">{e.notes}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>
