---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BandCard from '../components/BandCard.astro';
import { site } from '../lib/site';

const bands = (await getCollection('bands')).sort((a, b) =>
  (b.data.yearStart ?? 0) - (a.data.yearStart ?? 0)
);
const featured = bands.filter((b) => b.data.featured).slice(0, 4);
const allCount = bands.length;
const roleCounts = bands.reduce<Record<string, number>>((acc, b) => {
  acc[b.data.role] = (acc[b.data.role] ?? 0) + 1;
  return acc;
}, {});
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Layout · Sidebar">
  <div class="mx-auto max-w-7xl px-6 grid md:grid-cols-12 gap-10 py-10">
    <!-- Persistent left sidebar -->
    <aside class="md:col-span-4 lg:col-span-3 md:sticky md:top-6 md:self-start panel-dark p-6 space-y-6">
      <div>
        <p class="eyebrow mb-2">Layout · Sidebar</p>
        <h1 class="font-[var(--font-display)] text-3xl font-bold leading-tight text-[var(--color-dark-text)]">Julian Smith</h1>
        <p class="font-[var(--font-display)] italic text-lg text-[var(--color-dark-muted)] mt-1">Bass and flute, Northern Rivers.</p>
      </div>

      <div class="aspect-[4/5] bg-[var(--color-dark-soft)] border border-[var(--color-dark-soft)] overflow-hidden">
        <img src={`${base}/images/portrait.jpg`} alt="Julian Smith" class="w-full h-full object-cover" onerror="this.style.display='none'" />
      </div>

      <div class="font-[var(--font-sans)] text-sm">
        <p class="eyebrow mb-2">Plays</p>
        <ul class="space-y-0.5 text-[var(--color-dark-text)]">
          <li>Double bass</li>
          <li>Electric bass</li>
          <li>Flute</li>
          <li>Hand percussion</li>
          <li>Harmony vocals</li>
        </ul>
      </div>

      <div class="font-[var(--font-sans)] text-sm">
        <p class="eyebrow mb-2">Browse</p>
        <ul class="space-y-1">
          <li><a href={`${base}/bands?role=core`} class="text-[var(--color-dark-text)] hover:underline">Core member <span class="text-[var(--color-dark-muted)]">({roleCounts.core ?? 0})</span></a></li>
          <li><a href={`${base}/bands?role=sub`} class="text-[var(--color-dark-text)] hover:underline">Sub <span class="text-[var(--color-dark-muted)]">({roleCounts.sub ?? 0})</span></a></li>
          <li><a href={`${base}/bands?role=session`} class="text-[var(--color-dark-text)] hover:underline">Session <span class="text-[var(--color-dark-muted)]">({roleCounts.session ?? 0})</span></a></li>
          <li><a href={`${base}/recordings`} class="text-[var(--color-dark-text)] hover:underline">Recordings</a></li>
          <li><a href={`${base}/live`} class="text-[var(--color-dark-text)] hover:underline">Live</a></li>
          <li><a href={`${base}/for-hire`} class="text-[var(--color-dark-text)] hover:underline">For hire</a></li>
        </ul>
      </div>
    </aside>

    <!-- Scrolling main column -->
    <div class="md:col-span-8 lg:col-span-9 space-y-12">
      <section>
        <p class="eyebrow mb-3">About</p>
        <p class="text-lg text-[var(--color-ink)] leading-relaxed max-w-2xl">
          Plays in {roleCounts.core ?? 0} bands across jazz, folk, blues, funk
          and various world influences. Subs on bass for several others,
          sessions when needed, and runs live sound.
        </p>
        <blockquote class="pullquote mt-6">
          &ldquo;{site.bio}&rdquo;
        </blockquote>
        {site.bioSource && (
          <p class="text-xs text-[var(--color-muted)] font-[var(--font-sans)]">
            via <a href={site.bioSource.url} class="editorial">{site.bioSource.label}</a>
          </p>
        )}
      </section>

      <section>
        <div class="flex items-end justify-between mb-5 border-b border-[var(--color-rule)] pb-3">
          <h2 class="font-[var(--font-display)] text-2xl font-bold">Featured bands</h2>
          <a href={`${base}/bands`} class="font-[var(--font-sans)] text-sm text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]">All {allCount} →</a>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {featured.map((band) => <BandCard band={band} />)}
        </div>
      </section>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 pb-10">
    <p class="text-xs text-[var(--color-muted)] font-[var(--font-sans)]">
      Layout option · Sidebar. <a href={`${base}/`} class="editorial">Back to original</a> · <a href={`${base}/layout-mosaic`} class="editorial">Try mosaic</a>
    </p>
  </div>
</Base>
