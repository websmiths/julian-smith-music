---
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
import '../styles/global.css';

const bands = (await getCollection('bands')).sort((a, b) =>
  (b.data.yearStart ?? 0) - (a.data.yearStart ?? 0)
);
const featured = bands.filter((b) => b.data.featured).slice(0, 3);
const allCount = bands.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Style B — Vinyl · Julian Smith</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #0d0b08;
        --bg-soft: #16130e;
        --paper: #f1eadc;
        --paper-soft: #c8bfa8;
        --muted: #6e6452;
        --gold: #d4a04a;
        --copper: #c97a4d;
        --teal: #4a8a8a;
        --rule: rgba(241,234,220,0.12);
      }
      html, body { background: var(--bg); color: var(--paper); margin: 0; }
      body {
        font-family: "DM Serif Display", Georgia, serif;
        -webkit-font-smoothing: antialiased;
        background-image:
          radial-gradient(circle at 20% 10%, rgba(212,160,74,0.10), transparent 40%),
          radial-gradient(circle at 80% 60%, rgba(74,138,138,0.08), transparent 45%);
        min-height: 100vh;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence baseFrequency='0.85' /></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.5'/></svg>");
        opacity: 0.04;
        z-index: 1;
      }
      .display { font-family: "DM Serif Display", serif; }
      .sans { font-family: "Inter", system-ui, sans-serif; }
      .mono { font-family: "JetBrains Mono", ui-monospace, monospace; }
      .eyebrow {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--gold);
      }
      .glow-link {
        position: relative;
        text-decoration: none;
        color: var(--paper);
        transition: color 0.3s ease;
      }
      .glow-link::after {
        content: "";
        position: absolute;
        left: 0; right: 0; bottom: -3px;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--gold), transparent);
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.4s cubic-bezier(0.2,0.7,0.3,1);
      }
      .glow-link:hover { color: var(--gold); }
      .glow-link:hover::after { transform: scaleX(1); }
      .vinyl-card {
        position: relative;
        padding: 2rem;
        background: linear-gradient(160deg, rgba(241,234,220,0.04), rgba(241,234,220,0.01));
        border: 1px solid var(--rule);
        border-radius: 0;
        overflow: hidden;
        transition: border-color 0.4s ease, transform 0.4s ease;
      }
      .vinyl-card::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, var(--accent, var(--gold)) 0%, transparent 60%);
        opacity: 0;
        transition: opacity 0.5s ease;
        pointer-events: none;
      }
      .vinyl-card:hover {
        border-color: var(--accent, var(--gold));
        transform: translateY(-3px);
      }
      .vinyl-card:hover::after { opacity: 0.08; }
      .vinyl-card::before {
        content: "";
        position: absolute;
        top: 0; left: 0;
        width: 30px; height: 30px;
        border-top: 1px solid var(--accent, var(--gold));
        border-left: 1px solid var(--accent, var(--gold));
      }
      .corner-br::after {
        content: "";
        position: absolute;
        bottom: 0; right: 0;
        width: 30px; height: 30px;
        border-bottom: 1px solid var(--accent, var(--gold));
        border-right: 1px solid var(--accent, var(--gold));
      }
      .arc-divider {
        display: block;
        width: 100%;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--rule) 30%, var(--gold) 50%, var(--rule) 70%, transparent);
      }
      main { position: relative; z-index: 2; }
    </style>
  </head>
  <body>
    <header style="position: relative; z-index: 3; padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: baseline; max-width: 1280px; margin: 0 auto; border-bottom: 1px solid var(--rule);">
      <a href={`${base}/`} class="display" style="font-size: 1.4rem; text-decoration: none; color: var(--paper); letter-spacing: 0.01em;">
        Julian Smith<span style="color: var(--gold); font-style: italic;"> · music</span>
      </a>
      <nav class="sans" style="display: flex; gap: 2rem; font-size: 0.85rem;">
        <a href="#" class="glow-link">Bands</a>
        <a href="#" class="glow-link">Recordings</a>
        <a href="#" class="glow-link">Live</a>
        <a href="#" class="glow-link">For hire</a>
      </nav>
    </header>

    <main>
    <!-- Hero -->
    <section style="padding: 6rem 2rem 5rem; max-width: 1280px; margin: 0 auto;">
      <p class="eyebrow" style="margin: 0 0 2rem;">— Issue №1 · Northern Rivers, NSW</p>
      <h1 class="display" style="font-size: clamp(3rem, 10vw, 8.5rem); line-height: 0.9; letter-spacing: -0.02em; margin: 0; font-weight: 400;">
        <span style="display: block;">Julian Smith,</span>
        <span style="display: block; font-style: italic; color: var(--paper-soft); margin-left: 0.4em;">on bass &amp;</span>
        <span style="display: block; font-style: italic; color: var(--gold); margin-left: 1em;">flute &amp; whatever</span>
        <span style="display: block;">else.</span>
      </h1>

      <div style="margin-top: 4rem; display: grid; grid-template-columns: 2fr 1fr; gap: 4rem; align-items: end; max-width: 920px;">
        <p class="sans" style="font-size: 1.1rem; line-height: 1.6; color: var(--paper-soft); max-width: 36rem;">
          Several decades on stages and in studios — jazz, folk, blues, funk, gypsy swing, Hawaiian hapa haole, cosmic country, and an Afrobeat band that calls itself Timbuktu. {allCount} projects logged.
        </p>
        <a href="#" class="sans" style="display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.95rem 1.6rem; background: var(--gold); color: var(--bg); text-decoration: none; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; white-space: nowrap; transition: background 0.3s ease;">
          Available for hire →
        </a>
      </div>
    </section>

    <hr class="arc-divider" style="margin: 0 auto; max-width: 1280px;" />

    <!-- Bio quote -->
    <section style="padding: 6rem 2rem; max-width: 1000px; margin: 0 auto; text-align: center;">
      <p class="eyebrow" style="margin: 0 0 2rem;">In his own words</p>
      <blockquote class="display" style="font-size: clamp(1.6rem, 3.5vw, 2.6rem); line-height: 1.32; font-style: italic; color: var(--paper); margin: 0; font-weight: 400;">
        &ldquo;{site.bio}&rdquo;
      </blockquote>
      <p class="mono" style="margin-top: 2rem; font-size: 0.78rem; color: var(--muted); letter-spacing: 0.1em;">
        — VIA MUSIC COLLECTIVE AUSTRALIA
      </p>
    </section>

    <hr class="arc-divider" style="margin: 0 auto; max-width: 1280px;" />

    <!-- Instruments strip -->
    <section style="padding: 4rem 2rem; max-width: 1100px; margin: 0 auto;">
      <p class="eyebrow" style="text-align: center; margin: 0 0 2rem;">Plays</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1.5rem;">
        {[
          'Double bass',
          'Electric bass',
          'Flute',
          'Percussion',
          'Harmony vocals',
        ].map((label) => (
          <div style="text-align: center;">
            <p class="display" style="font-size: 1.2rem; margin: 0; color: var(--paper);">{label}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="arc-divider" style="margin: 0 auto; max-width: 1280px;" />

    <!-- Featured bands -->
    <section style="padding: 5rem 2rem 7rem; max-width: 1280px; margin: 0 auto;">
      <div style="display: flex; align-items: end; justify-content: space-between; margin-bottom: 3rem;">
        <div>
          <p class="eyebrow" style="margin: 0 0 0.6rem;">— Selected</p>
          <h2 class="display" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0; line-height: 1; letter-spacing: -0.01em;">
            Bands <span style="font-style: italic; color: var(--gold);">in rotation</span>
          </h2>
        </div>
        <a href="#" class="sans glow-link" style="font-size: 0.9rem;">See all {allCount} →</a>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
        {featured.map((band, i) => {
          const accents = ['var(--gold)', 'var(--copper)', 'var(--teal)'];
          return (
            <article class="vinyl-card corner-br" style={`--accent: ${accents[i % accents.length]}`}>
              <p class="mono" style="margin: 0 0 1rem; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--paper-soft);">Core member</p>
              <h3 class="display" style="font-size: 2.2rem; line-height: 1; margin: 0 0 0.5rem; color: var(--paper);">{band.data.name}</h3>
              <p class="mono" style="margin: 0; color: var(--muted); font-size: 0.78rem;">{band.data.era} · {band.data.region}</p>
              <p class="sans" style="margin: 1.2rem 0 1.5rem; line-height: 1.6; color: var(--paper-soft); font-size: 0.95rem;">{band.data.blurb}</p>
              <p class="mono" style="font-size: 0.7rem; color: var(--muted); margin: 0; letter-spacing: 0.12em; text-transform: uppercase;">
                Julian → <span style="color: var(--paper); letter-spacing: 0; text-transform: none;" class="sans">{band.data.julianRole}</span>
              </p>
            </article>
          );
        })}
      </div>
    </section>
    </main>

    <footer style="padding: 3rem 2rem; border-top: 1px solid var(--rule); text-align: center; position: relative; z-index: 2;">
      <p class="sans" style="margin: 0; color: var(--muted); font-size: 0.85rem;">
        Style prototype B — vinyl, after hours. <a href={`${base}/`} class="glow-link">Compare with the original →</a>
      </p>
    </footer>
  </body>
</html>
