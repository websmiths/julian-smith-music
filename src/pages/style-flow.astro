---
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
import '../styles/global.css';

const bands = (await getCollection('bands')).sort((a, b) =>
  (b.data.yearStart ?? 0) - (a.data.yearStart ?? 0)
);
const featured = bands.filter((b) => b.data.featured).slice(0, 3);
const allCount = bands.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Style A — Flow · Julian Smith</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..900,30..100;1,9..144,300..900,30..100&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #faf7f1;
        --ink: #14110d;
        --ink-soft: #2c2620;
        --muted: #7a6e5d;
        --jade: #2e6b5e;
        --rose: #c46f6a;
        --ochre: #d39a3c;
        --plum: #5c3760;
        --teal: #1f4d63;
      }
      html, body { background: var(--bg); color: var(--ink); }
      body {
        font-family: "Fraunces", Georgia, serif;
        font-feature-settings: "kern", "liga", "calt";
        font-variation-settings: "SOFT" 50;
        -webkit-font-smoothing: antialiased;
        margin: 0;
      }
      .display { font-family: "Fraunces", serif; font-variation-settings: "SOFT" 80, "opsz" 144; }
      .sans { font-family: "Inter", system-ui, sans-serif; }
      .eyebrow {
        font-family: "Inter", sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--muted);
      }
      .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.4;
        pointer-events: none;
      }
      .pill {
        display: inline-block;
        padding: 0.4rem 0.9rem;
        border-radius: 9999px;
        background: rgba(20, 17, 13, 0.06);
        font-family: "Inter", sans-serif;
        font-size: 0.78rem;
        letter-spacing: 0.04em;
      }
      .underline-grow {
        background-image: linear-gradient(currentColor, currentColor);
        background-repeat: no-repeat;
        background-position: 0 100%;
        background-size: 0% 1px;
        transition: background-size 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
      }
      .underline-grow:hover { background-size: 100% 1px; }
      .feature-card {
        position: relative;
        padding: 2rem;
        border-radius: 1.5rem;
        background: white;
        box-shadow: 0 1px 0 rgba(20,17,13,0.04), 0 30px 50px -30px rgba(20,17,13,0.18);
        transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.4s ease;
      }
      .feature-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 1px 0 rgba(20,17,13,0.06), 0 40px 60px -30px rgba(20,17,13,0.25);
      }
      .feature-card::before {
        content: "";
        position: absolute;
        inset: -1px;
        border-radius: 1.5rem;
        background: linear-gradient(135deg, var(--accent, var(--jade)) 0%, transparent 60%);
        opacity: 0.08;
        pointer-events: none;
      }
      .wave {
        display: block;
        width: 100%;
        height: 80px;
      }
    </style>
  </head>
  <body>
    <header style="padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: baseline; max-width: 1280px; margin: 0 auto;">
      <a href={`${base}/`} class="display" style="font-size: 1.4rem; font-weight: 700; text-decoration: none; color: var(--ink);">
        Julian Smith<span style="color: var(--muted); font-style: italic; font-weight: 400;"> · music</span>
      </a>
      <nav class="sans" style="display: flex; gap: 2rem; font-size: 0.9rem;">
        <a href="#" class="underline-grow" style="color: var(--ink); text-decoration: none;">Bands</a>
        <a href="#" class="underline-grow" style="color: var(--ink); text-decoration: none;">Recordings</a>
        <a href="#" class="underline-grow" style="color: var(--ink); text-decoration: none;">Live</a>
        <a href="#" class="underline-grow" style="color: var(--ink); text-decoration: none;">For hire</a>
      </nav>
    </header>

    <!-- Hero -->
    <section style="position: relative; overflow: hidden; padding: 4rem 2rem 6rem;">
      <div class="blob" style="background: var(--ochre); width: 480px; height: 480px; top: -100px; right: -120px;"></div>
      <div class="blob" style="background: var(--jade); width: 360px; height: 360px; top: 40%; left: -120px; opacity: 0.35;"></div>
      <div class="blob" style="background: var(--rose); width: 280px; height: 280px; bottom: -80px; right: 30%; opacity: 0.25;"></div>

      <div style="max-width: 1280px; margin: 0 auto; position: relative;">
        <p class="eyebrow" style="margin-bottom: 1.5rem;">A working musician's archive</p>
        <h1 class="display" style="font-size: clamp(3rem, 9vw, 7.5rem); line-height: 0.92; letter-spacing: -0.025em; font-weight: 400; max-width: 14ch; margin: 0;">
          Julian Smith,
          <span style="display: block; font-style: italic; font-weight: 300; color: var(--ink-soft); font-variation-settings: 'SOFT' 100; margin-left: 0.6em;">on bass</span>
          <span style="display: block; font-style: italic; font-weight: 300; color: var(--jade); font-variation-settings: 'SOFT' 100; margin-left: 1.4em;">&amp; flute</span>
          <span style="display: block; font-weight: 700;">&amp; whatever else.</span>
        </h1>

        <div style="margin-top: 3rem; display: grid; grid-template-columns: 1fr auto; gap: 4rem; align-items: end; max-width: 880px;">
          <p style="font-size: 1.2rem; line-height: 1.5; color: var(--ink-soft); max-width: 32rem;">
            Northern Rivers, NSW. Several decades on stages and in studios across jazz, folk, blues, funk and points further afield.
          </p>
          <a href="#" class="sans" style="display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.95rem 1.5rem; background: var(--ink); color: var(--bg); border-radius: 9999px; text-decoration: none; font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; font-weight: 600; white-space: nowrap;">
            Available for hire
            <span style="display: inline-block; transform: translateX(0); transition: transform 0.3s ease;">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Wave divider -->
    <svg class="wave" viewBox="0 0 1440 80" preserveAspectRatio="none" style="background: var(--bg);">
      <path d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z" fill="rgba(46, 107, 94, 0.08)"/>
    </svg>

    <!-- Bio quote on tinted band -->
    <section style="background: rgba(46, 107, 94, 0.08); padding: 5rem 2rem; position: relative;">
      <div style="max-width: 880px; margin: 0 auto; text-align: center;">
        <p class="eyebrow" style="margin-bottom: 1.5rem;">In his own words</p>
        <blockquote class="display" style="font-size: clamp(1.5rem, 3.2vw, 2.4rem); line-height: 1.3; font-style: italic; color: var(--ink); font-variation-settings: 'SOFT' 90; margin: 0;">
          &ldquo;{site.bio}&rdquo;
        </blockquote>
        <p class="sans" style="margin-top: 2rem; font-size: 0.85rem; color: var(--muted);">
          via Music Collective Australia
        </p>
      </div>
    </section>

    <svg class="wave" viewBox="0 0 1440 80" preserveAspectRatio="none" style="background: rgba(46, 107, 94, 0.08); transform: scaleY(-1);">
      <path d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z" fill="var(--bg)"/>
    </svg>

    <!-- Instruments strip -->
    <section style="padding: 4rem 2rem;">
      <div style="max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1.5rem; text-align: center;">
        {[
          { label: 'Double bass', accent: 'var(--teal)' },
          { label: 'Electric bass', accent: 'var(--ochre)' },
          { label: 'Flute', accent: 'var(--jade)' },
          { label: 'Percussion', accent: 'var(--plum)' },
          { label: 'Harmony vocals', accent: 'var(--rose)' },
        ].map((item) => (
          <div style={`padding: 1.5rem 0; border-top: 3px solid ${item.accent};`}>
            <p class="display" style="font-size: 1.1rem; font-weight: 600; margin: 0;">{item.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Featured bands -->
    <section style="padding: 4rem 2rem 6rem; max-width: 1280px; margin: 0 auto;">
      <div style="display: flex; align-items: end; justify-content: space-between; margin-bottom: 3rem;">
        <div>
          <p class="eyebrow" style="margin-bottom: 0.5rem;">Selected projects</p>
          <h2 class="display" style="font-size: clamp(2.2rem, 5vw, 3.5rem); margin: 0; font-weight: 700; letter-spacing: -0.02em;">
            Bands
            <span style="font-style: italic; font-weight: 300; color: var(--muted); font-variation-settings: 'SOFT' 100;"> in rotation</span>
          </h2>
        </div>
        <a href="#" class="sans underline-grow" style="font-size: 0.95rem; color: var(--ink);">See all {allCount} →</a>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        {featured.map((band, i) => {
          const accents = ['var(--jade)', 'var(--ochre)', 'var(--plum)', 'var(--teal)'];
          return (
            <article class="feature-card" style={`--accent: ${accents[i % accents.length]}`}>
              <p class="eyebrow" style={`color: ${accents[i % accents.length]}; margin-bottom: 0.75rem;`}>Core member</p>
              <h3 class="display" style="font-size: 2rem; line-height: 1.05; margin: 0 0 0.4rem; font-weight: 700; letter-spacing: -0.02em;">{band.data.name}</h3>
              <p class="sans" style="margin: 0; color: var(--muted); font-size: 0.85rem;">{band.data.era}{band.data.region ? ` · ${band.data.region}` : ''}</p>
              <p style="margin: 1rem 0 1.5rem; line-height: 1.55; color: var(--ink-soft);">{band.data.blurb}</p>
              <p class="sans" style="font-size: 0.78rem; color: var(--muted); margin: 0; text-transform: uppercase; letter-spacing: 0.1em;">
                Julian: <span style="color: var(--ink-soft); text-transform: none; letter-spacing: 0;">{band.data.julianRole}</span>
              </p>
            </article>
          );
        })}
      </div>
    </section>

    <footer style="padding: 3rem 2rem; border-top: 1px solid rgba(20,17,13,0.08); text-align: center;">
      <p class="sans" style="margin: 0; color: var(--muted); font-size: 0.85rem;">
        Style prototype A — flowing, color-led. <a href={`${base}/`} class="underline-grow" style="color: var(--ink);">Compare with the original →</a>
      </p>
    </footer>
  </body>
</html>
